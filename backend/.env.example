# ============================================
# CareerPilot Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env files with real secrets
# ============================================

# --- App ---
APP_NAME=CareerPilot
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careerpilot
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/careerpilot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Supabase ---
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- AI ---
AI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_RATE_LIMIT=10/minute

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
